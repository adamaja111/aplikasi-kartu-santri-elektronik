<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/cream_green">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:adjustViewBounds="true"
            android:src="@drawable/img_back_btn"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detail Santri"
            android:textColor="@color/navy_one"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="18sp"
            android:includeFontPadding="false"
            />

        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:adjustViewBounds="true"
            android:src="@drawable/img_edit_santri"
            />
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:adjustViewBounds="true"
            android:layout_marginEnd="8dp"
            android:src="@drawable/img_delete_santri"
            />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:src="@color/green"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        android:layout_marginHorizontal="16dp"
        />

    <ImageView
        android:id="@+id/ivQrSantri"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        tools:src="@drawable/qr_example"
        android:adjustViewBounds="true"
        app:layout_constraintWidth_percent="0.45"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        android:layout_margin="16dp"
        />

    <LinearLayout
        android:id="@+id/namaLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/ivQrSantri"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivQrSantri"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNamaSantri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/poppins_bold"
            tools:text="Selena Gomez Halim"
            android:textSize="18sp"
            android:layout_marginStart="4dp"
            android:textColor="@color/main_green_deep"
            />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNisSantri"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/poppins_medium"
        tools:text="NIS : S003"
        android:textSize="14sp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:textAlignment="center"
        android:textColor="@color/navy_one"
        app:layout_constraintStart_toEndOf="@id/ivQrSantri"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/namaLayout"
        />

    <LinearLayout
        android:id="@+id/ttlLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/ivQrSantri"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNisSantri"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/img_calendar"
            />

        <TextView
            android:id="@+id/tvTtlSantri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/poppins"
            tools:text="Banten, 24/12/2001"
            android:textSize="10sp"
            android:layout_marginStart="2dp"
            android:textColor="@color/navy_one"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/genderLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/ivQrSantri"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ttlLayout"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivJenisKelamin"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:padding="3dp"
            android:src="@drawable/img_male"
            />

        <TextView
            android:id="@+id/tvJenisKelamin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/poppins"
            tools:text="Laki-laki"
            android:textSize="10sp"
            android:layout_marginStart="2dp"
            android:textColor="@color/navy_one"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/phoneLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/ivQrSantri"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/genderLayout"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:padding="2dp"
            android:src="@drawable/img_phone"
            />

        <TextView
            android:id="@+id/tvNomorTelpon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/poppins"
            tools:text="081234567890"
            android:textSize="10sp"
            android:layout_marginStart="2dp"
            android:textColor="@color/navy_one"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emailLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/ivQrSantri"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/phoneLayout"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:padding="2dp"
            android:src="@drawable/img_email"
            />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/poppins"
            tools:text="santri@gmail.com"
            android:textSize="10sp"
            android:layout_marginStart="2dp"
            android:textColor="@color/navy_one"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/addressLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/ivQrSantri"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emailLayout"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:padding="2dp"
            android:src="@drawable/img_address"
            />

        <TextView
            android:id="@+id/tvAlamat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/poppins"
            tools:text="Jalan apel gang buah-buahan nomor C1"
            android:textSize="10sp"
            android:layout_marginStart="2dp"
            android:textColor="@color/navy_one"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/socmedLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivQrSantri"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/img_facebook"
                    />

                <TextView
                    android:id="@+id/tvFacebook"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/poppins"
                    tools:text="UsernameFacebook"
                    android:textSize="10sp"
                    android:textAlignment="center"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/navy_one"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/img_instagram"
                    />

                <TextView
                    android:id="@+id/tvInstagram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/poppins"
                    tools:text="UsernameInstagram"
                    android:textSize="10sp"
                    android:textAlignment="center"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/navy_one"
                    />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/img_twitter"
                />

            <TextView
                android:id="@+id/tvTwitter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="@font/poppins"
                tools:text="UsernameTwitter"
                android:textSize="10sp"
                android:textAlignment="center"
                android:layout_marginStart="4dp"
                android:textColor="@color/navy_one"
                />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/santriDetailTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/main_green"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        app:tabIconTint="@android:color/transparent"
        app:tabBackground="@drawable/tab_color_selector"
        app:layout_constraintTop_toBottomOf="@id/socmedLayout"
        />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/santriDetailViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/santriDetailTabLayout"
        />

    <ImageView
        android:id="@+id/btnDownloadSantri"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:padding="16dp"
        android:background="@drawable/yellowbox_container_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="24dp"
        android:src="@drawable/img_download_santri"
        />
</androidx.constraintlayout.widget.ConstraintLayout>