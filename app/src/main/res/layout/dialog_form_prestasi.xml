<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:orientation="vertical"
    android:background="@drawable/creambox_radius_24"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="16dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        >
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/img_award"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Formulir Riwayat Prestasi"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/navy_one"
            android:textSize="15sp"
            android:textAlignment="center"
            android:layout_marginStart="8dp"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:layout_weight="1"
            />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nama Kegiatan : "
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/navy_one"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:layout_marginTop="12dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etNamaPrestasi"
        android:hint=" "
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_box"
            android:fontFamily="@font/poppins"
            android:hint="Nama Kegiatan"
            android:padding="10dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textColorHint="@color/brown_green_medium"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Peringkat/Peserta : "
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/navy_one"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:layout_marginTop="12dp"
        />

    <Spinner
        android:id="@+id/peringkatSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/edit_text_box"
        android:popupBackground="@drawable/edit_text_box"
        />

