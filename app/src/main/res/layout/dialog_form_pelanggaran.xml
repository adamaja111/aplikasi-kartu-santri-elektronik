<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:orientation="vertical"
    android:background="@drawable/creambox_radius_24"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="16dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        >
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/img_pelanggaran"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Formulir Riwayat Pelanggaran"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/navy_one"
            android:textSize="14sp"
            android:textAlignment="center"
            android:layout_marginStart="8dp"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:layout_weight="1"
            />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nama Pelanggaran :"
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/navy_one"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:layout_marginTop="12dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etNamaPelanggaran"
        android:hint=" "
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_box"
            android:fontFamily="@font/poppins"
            android:hint="Nama Pelanggaran"
            android:padding="10dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textColorHint="@color/brown_green_medium"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tanggal Pelanggaran : "
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/navy_one"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:layout_marginTop="8dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etTglPelanggaran"
        android:hint=" "
        android:editable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_box"
            android:fontFamily="@font/poppins"
            android:hint="Tanggal Pelanggaran"
            android:padding="10dp"
            android:textSize="14sp"
            android:editable="false"
            android:textColor="@color/black"
            android:textColorHint="@color/brown_green_medium"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jenis Pelanggaran : "
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/navy_one"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:layout_marginTop="8dp"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/radioJenisPelanggaran"
            android:layout_weight="2"
            android:orientation="horizontal">

            <RadioButton android:id="@+id/radioJenisSedang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textSize="15sp"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:text="Sedang"/>

            <RadioButton android:id="@+id/radioJenisBerat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textSize="15sp"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:text="Berat"/>
        </RadioGroup>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Poin Pelanggaran :"
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/navy_one"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:layout_marginTop="8dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etPoinPelanggaran"
        android:hint=" "
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_box"
            android:fontFamily="@font/poppins"
            android:hint="Contoh: Sedang (5-8), Berat (10-15)"
            android:padding="10dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textColorHint="@color/brown_green_medium"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sanksi yang diterima :"
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/navy_one"
        android:textSize="14sp"
        android:includeFontPadding="false"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etSanksiPelanggaran"
        android:hint=" "
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_box"
            android:fontFamily="@font/poppins"
            android:hint="Sanksi Pelanggaran"
            android:padding="10dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textColorHint="@color/brown_green_medium"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tanggal Sanksi : "
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/navy_one"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:layout_marginTop="8dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etTglSanksi"
        android:hint=" "
        android:editable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_box"
            android:fontFamily="@font/poppins"
            android:hint="Tanggal Sanksi"
            android:padding="10dp"
            android:textSize="14sp"
            android:editable="false"
            android:textColor="@color/black"
            android:textColorHint="@color/brown_green_medium"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_menu_btn"
        android:text="Tambah"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        />

</LinearLayout>