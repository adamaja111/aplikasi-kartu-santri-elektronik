<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="4dp"
    android:padding="8dp"
    android:gravity="center"
    android:background="@drawable/grentwobox_container_12"
    >



    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="4dp"
        android:layout_weight="1"
        android:gravity="center"
        >
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/img_award"
            />
        <TextView
            android:id="@+id/tvNamaPrestasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Nama Prestasi"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/main_green_deep"
            android:textSize="12sp"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:layout_marginTop="8dp"
            />
        <TextView
            android:id="@+id/tvPeringkatTingkatPrestasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Peringkat Satu (Provinsi)"
            android:fontFamily="@font/poppins"
            android:textColor="@color/main_green"
            android:textSize="11sp"
            android:textAlignment="center"
            android:includeFontPadding="false"
            />
        <TextView
            android:id="@+id/tvTglPrestasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="24/09/2021"
            android:fontFamily="@font/poppins"
            android:textColor="@color/main_green"
            android:textSize="11sp"
            android:textAlignment="center"
            android:includeFontPadding="false"
            />

        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/baseline_delete_24"
            />
    </LinearLayout>


</LinearLayout>