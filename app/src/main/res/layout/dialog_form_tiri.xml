<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:orientation="vertical"
    android:background="@drawable/creambox_radius_24"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="16dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        >
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/img_parent_santri"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Formulir Orang Tua Tiri"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/navy_one"
            android:textSize="15sp"
            android:textAlignment="center"
            android:layout_marginStart="8dp"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:layout_weight="1"
            />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nama Ayah/Ibu Tiri :"
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/navy_one"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:layout_marginTop="12dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etNamaTiri"
        android:hint=" "
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_box"
            android:fontFamily="@font/poppins"
            android:hint="Masukkan Nama"
            android:padding="10dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textColorHint="@color/brown_green_medium"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" Nomor Telepon Ayah/Ibu Tiri :"
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/navy_one"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:layout_marginTop="12dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etTelponTiri"
        android:hint=" "
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_box"
            android:fontFamily="@font/poppins"
            android:hint="Masukkan Nomor Telepon"
            android:padding="10dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textColorHint="@color/brown_green_medium"
            android:inputType="phone" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alamat Orang Tua Tiri : "
        android:fontFamily="@font/poppins_light"
        android:textColor="@color/navy_one"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:layout_marginTop="8dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/etAlamatTiri"
        android:hint=" "
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:background="@drawable/edit_text_box"
            android:fontFamily="@font/poppins"
            android:hint="Masukkan Alamat"
            android:padding="10dp"
            android:gravity="start"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textColorHint="@color/brown_green_medium"
            android:inputType="textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_menu_btn"
        android:text="Tambah"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        />

</LinearLayout>